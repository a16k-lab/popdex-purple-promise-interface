# Optional. Deployed origin for social-preview tags (og:image / og:url). On Vercel this is
# derived automatically from VERCEL_PROJECT_PRODUCTION_URL; set it only for a custom domain.
VITE_SITE_URL=

# Optional epoch overrides (fall back to the current Monday-to-Monday UTC week).
VITE_EPOCH_START=
VITE_EPOCH_END=
VITE_EPOCH_NUMBER=
VITE_TARGET_VOLUME_USD=100000

# Optional shared cache (Upstash Redis via Vercel Marketplace / Vercel KV). Finished
# epoch windows are stored per wallet so repeat lookups by anyone are instant.
# Either pair works; leave empty to use the per-instance memory cache only.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
